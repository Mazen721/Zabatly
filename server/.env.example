# Copy this file to .env and fill in your real values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/car_rental_project
JWT_SECRET=replace_with_a_long_random_secret

# Google AI Studio — https://aistudio.google.com/app/apikey
# Used for chat and OCR when local Ollama / Python OCR are unavailable.
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary — https://cloudinary.com/console (Programmable Media)
# Used by multer-storage-cloudinary for vehicle images, profile photos, KYC, payment proof.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
